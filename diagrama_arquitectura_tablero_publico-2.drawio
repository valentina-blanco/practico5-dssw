<mxfile host="app.diagrams.net">
  <diagram id="arq-tablero-publico" name="Arquitectura tablero publico">
    <mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="titulo" value="Arquitectura propuesta - Tablero de puntajes público (OWASP Threat Modeling Process)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="-30" width="900" height="30" as="geometry" />
        </mxCell>

        <!-- Zonas / fronteras de confianza -->
        <mxCell id="zona_internet" value="INTERNET (zona no confiable)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=14;opacity=60;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="220" height="760" as="geometry" />
        </mxCell>
        <mxCell id="zona_dmz" value="DMZ (zona pública, solo lectura)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=14;opacity=60;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="380" height="760" as="geometry" />
        </mxCell>
        <mxCell id="zona_interna" value="RED INTERNA (arena - WiFi con SSID exclusivo / Servidores)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=14;opacity=60;" vertex="1" parent="1">
          <mxGeometry x="740" y="20" width="740" height="760" as="geometry" />
        </mxCell>

        <mxCell id="ft1" value="Frontera de confianza 1&lt;br&gt;(Firewall Internet - DMZ)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#b85450;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="230" y="740" width="80" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ft2" value="Frontera de confianza 2&lt;br&gt;(Firewall DMZ - Red interna)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#b85450;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="665" y="740" width="90" height="40" as="geometry" />
        </mxCell>

        <!-- INTERNET -->
        <mxCell id="actor_publico" value="Público anónimo&lt;br&gt;(navegador)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="330" width="40" height="70" as="geometry" />
        </mxCell>

        <!-- DMZ -->
        <mxCell id="cdn" value="CDN / WAF / Reverse proxy&lt;br&gt;(TLS 1.2+, HSTS, rate limiting)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="80" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="spa" value="Tablero público (SPA estática)&lt;br&gt;nginx sobre Linux hardenizado&lt;br&gt;Solo contenido estático" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="200" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="api_pub" value="API pública de lectura&lt;br&gt;Solo métodos GET (sin escritura)&lt;br&gt;Resultados en vivo e históricos (SSE / polling)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="330" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="bd_pub" value="BD de publicación&lt;br&gt;(base separada, solo datos publicables)&lt;br&gt;Cuentas: publicador = escritura&lt;br&gt;API pública = solo SELECT" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="460" width="260" height="130" as="geometry" />
        </mxCell>
        <mxCell id="nota_dmz" value="La DMZ NO puede iniciar conexiones hacia la red interna" style="text;html=1;strokeColor=#b85450;fillColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;fontColor=#b85450;fontStyle=1;whiteSpace=wrap;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="625" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="monitoreo" value="Monitoreo y logs centralizados&lt;br&gt;(CDN/WAF, API pública, publicador)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="690" width="300" height="50" as="geometry" />
        </mxCell>

        <!-- RED INTERNA -->
        <mxCell id="actor_juez" value="Juez" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="780" y="60" width="40" height="70" as="geometry" />
        </mxCell>
        <mxCell id="app_mobile" value="APP Mobile&lt;br&gt;(tableta Android de la federación)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="900" y="60" width="190" height="70" as="geometry" />
        </mxCell>
        <mxCell id="actor_mesa" value="Mesa de control" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="780" y="300" width="40" height="70" as="geometry" />
        </mxCell>
        <mxCell id="actor_admin" value="Admin" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="780" y="440" width="40" height="70" as="geometry" />
        </mxCell>
        <mxCell id="web_int" value="Web de gestión (SPA)&lt;br&gt;Mesa de control / Admin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="940" y="350" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="api_int" value="API REST interna&lt;br&gt;(Spring sobre Linux hardenizado)&lt;br&gt;Autenticación, roles, notas, resultados" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1180" y="190" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="bd_ppal" value="BD principal&lt;br&gt;(PostgreSQL)&lt;br&gt;Notas, gimnastas, torneos" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1200" y="410" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="sync" value="Servicio de sincronización / publicador&lt;br&gt;Publica solo resultados confirmados&lt;br&gt;por la Mesa de control" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1000" y="620" width="280" height="80" as="geometry" />
        </mxCell>

        <!-- FLUJOS (numeracion 12-17 = DFD del informe) -->
        <mxCell id="e1" value="12 · HTTPS (443)" style="endArrow=classic;html=1;rounded=0;fontSize=11;" edge="1" parent="1" source="actor_publico" target="cdn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="13 · HTTPS" style="endArrow=classic;html=1;rounded=0;fontSize=11;" edge="1" parent="1" source="cdn" target="spa">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="14 · HTTPS (solo GET)" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;html=1;rounded=0;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cdn" target="api_pub">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="662" y="115" />
              <mxPoint x="662" y="370" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e4" value="15 · SQL (usuario de solo lectura)" style="endArrow=classic;html=1;rounded=0;fontSize=11;" edge="1" parent="1" source="api_pub" target="bd_pub">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e5" value="Utiliza" style="endArrow=classic;html=1;rounded=0;fontSize=11;" edge="1" parent="1" source="actor_juez" target="app_mobile">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="REST / HTTPS (WiFi SSID exclusivo)" style="endArrow=classic;html=1;rounded=0;fontSize=11;" edge="1" parent="1" source="app_mobile" target="api_int">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="HTTPS" style="endArrow=classic;html=1;rounded=0;fontSize=11;" edge="1" parent="1" source="actor_mesa" target="web_int">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="HTTPS" style="endArrow=classic;html=1;rounded=0;fontSize=11;" edge="1" parent="1" source="actor_admin" target="web_int">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="REST / HTTPS" style="endArrow=classic;html=1;rounded=0;fontSize=11;" edge="1" parent="1" source="web_int" target="api_int">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="JDBC" style="endArrow=classic;html=1;rounded=0;fontSize=11;" edge="1" parent="1" source="api_int" target="bd_ppal">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" value="16 · Lectura de resultados confirmados" style="endArrow=classic;html=1;rounded=0;fontSize=11;" edge="1" parent="1" source="bd_ppal" target="sync">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" value="17 · Push unidireccional (mTLS + mensajes firmados)" style="endArrow=classic;html=1;rounded=0;fontSize=11;strokeWidth=3;strokeColor=#d79b00;fontStyle=1;" edge="1" parent="1" source="sync" target="bd_pub">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Leyenda -->
        <mxCell id="leyenda" value="&lt;b&gt;Leyenda y principios de diseño&lt;/b&gt;&lt;br&gt;1. El tablero público es de solo lectura y nunca se conecta a la BD principal.&lt;br&gt;2. Ningún endpoint de escritura de notas es accesible desde Internet.&lt;br&gt;3. La sincronización es unidireccional (red interna hacia DMZ) y autenticada.&lt;br&gt;4. Línea gruesa naranja: único flujo que cruza la frontera DMZ - red interna.&lt;br&gt;5. Zonas punteadas: fronteras de confianza (Internet / DMZ / Red interna).&lt;br&gt;6. Flujos 12 a 17: numeración del DFD del informe." style="text;html=1;strokeColor=#666666;fillColor=#ffffff;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=8;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="800" width="660" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
