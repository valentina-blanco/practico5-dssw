          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" edge="1" parent="1" source="api_int" style="endArrow=classic;html=1;rounded=0;fontSize=11;" target="bd_ppal" value="JDBC">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" edge="1" parent="1" source="bd_ppal" style="endArrow=classic;html=1;rounded=0;fontSize=11;" target="sync" value="16 · Vista de confirmados&lt;br&gt;(solo lectura, 2.º consumidor de la BD)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" edge="1" parent="1" source="sync" style="endArrow=classic;html=1;rounded=0;fontSize=11;strokeWidth=3;strokeColor=#d79b00;fontStyle=1;" target="bd_pub" value="17 · PostgreSQL sobre mTLS (5432), iniciado desde la LAN">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="leyenda" parent="1" style="text;html=1;strokeColor=#666666;fillColor=#ffffff;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=8;rounded=1;" value="&lt;b&gt;Leyenda y principios de diseño&lt;/b&gt;&lt;br&gt;1. El tablero público es de solo lectura y nunca se conecta a la BD principal.&lt;br&gt;2. Por diseño, no existe ningún endpoint de escritura accesible desde Internet.&lt;br&gt;3. La sincronización es unidireccional (red interna hacia DMZ): la inicia siempre el servicio de sincronización, con TLS mutuo (certificado de cliente).&lt;br&gt;4. Solo se publican notas confirmadas individualmente por la Mesa de control.&lt;br&gt;5. La administración de la DMZ y de las cuentas del CDN/DNS se hace desde la red interna, con MFA y mínimo privilegio.&lt;br&gt;6. Líneas gruesas naranjas: flujos iniciados desde la red interna hacia la DMZ o hacia el proveedor (17 y 18).&lt;br&gt;7. Zonas punteadas: fronteras de confianza (Internet / DMZ / Red interna). Flujos 12 a 18: numeración del DFD del informe." vertex="1">
          <mxGeometry height="190" width="760" x="20" y="880" as="geometry" />
        </mxCell>
        <mxCell id="fw1_reglas" parent="1" style="text;html=1;strokeColor=#b85450;fillColor=#ffffff;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;spacing=6;rounded=1;" value="&lt;b&gt;Firewall 1 (Internet - DMZ)&lt;/b&gt;&lt;br&gt;Permite 443 entrante al CDN; deniega el resto." vertex="1">
          <mxGeometry height="60" width="270" x="20" y="800" as="geometry" />
        </mxCell>
        <mxCell id="fw2_reglas" parent="1" style="text;html=1;strokeColor=#b85450;fillColor=#ffffff;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;spacing=6;rounded=1;" value="&lt;b&gt;Firewall 2 (DMZ - Red interna)&lt;/b&gt;&lt;br&gt;Permite solo conexiones iniciadas desde la LAN (5432 del sincronizador, SSH del bastión, recolección de logs); deniega toda conexión iniciada desde la DMZ." vertex="1">
          <mxGeometry height="60" width="430" x="310" y="800" as="geometry" />
        </mxCell>
        <mxCell id="e13" edge="1" parent="1" source="actor_admin" style="endArrow=classic;html=1;rounded=0;fontSize=11;strokeWidth=3;strokeColor=#d79b00;fontStyle=1;" target="bastion" value="18 · SSH">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14" edge="1" parent="1" source="bastion" style="endArrow=classic;html=1;rounded=0;fontSize=11;strokeWidth=3;strokeColor=#d79b00;fontStyle=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.658;entryDx=0;entryDy=0;" target="zona_dmz" value="18 · SSH (MFA)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
